# PRACTICE ONLY. Copy to practice/.env.local; never commit real credentials.
# Existing process variables take precedence over .env.local, then .env.
# EVI browser practice (all three required; no NEXT_PUBLIC credentials):
HUME_API_KEY=
HUME_SECRET_KEY=
HUME_CONFIG_ID=
# Optional immutable EVI config version; blank selects provider's current version.
HUME_CONFIG_VERSION=

# SambaNova (CLI and modular Pipecat). Use an exact model ID available to your account.
SAMBANOVA_API_KEY=
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
SAMBANOVA_MODEL=
PROVIDER_TIMEOUT_MS=60000

# Modular Pipecat route: Deepgram STT → SambaNova → Hume TTS.
# Reuses HUME_API_KEY above; EVI config/secret are not needed by this route.
DEEPGRAM_API_KEY=
# Actual Hume voice UUID, not the voice name or EVI config ID.
HUME_VOICE_ID=
# Optional: Deepgram defaults to nova-3-general, English.
DEEPGRAM_MODEL=nova-3-general
# Local WebRTC needs no additional transport API key. Server listens on 127.0.0.1:7860.
# Idle sessions end after 120 seconds, with a maximum session length of 10 minutes.

# Third route: Gradium STT → General Compute LLM → Gradium TTS (same Pipecat server).
# Independent of Hume, Deepgram, and SambaNova. See docs/generalcompute-gradium.md.
GENERALCOMPUTE_API_KEY=
GENERALCOMPUTE_BASE_URL=https://api.generalcompute.com/v1
# Copy the exact ID from your available models; do not use a display name.
GENERALCOMPUTE_MODEL=
GRADIUM_API_KEY=
# Gradium library voice ID, not a Hume UUID or an EVI configuration ID.
GRADIUM_VOICE_ID=
# auto routes to the nearest region; optional us or eu pins the endpoint.
GRADIUM_REGION=auto

# Research Orb: Jev routes requests; General Compute performs the analyses.
# Reuses GENERALCOMPUTE_* and, for voice, GRADIUM_* above.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Optional for supplied-source reading; required for discovering new papers.
EXA_API_KEY=
# Optional absolute path to a prepared Paper2Agent checkout. Blank uses the
# sibling Paper2Agent/ directory next to voice-ai-hackathon/, independent of cwd.
PAPER2AGENT_ROOT=

# Optional EVI bridge is NOT implemented or selected.
CLM_ENDPOINT_URL=
CLM_AUTH_SECRET=

# Optional network check target; no host is selected or authorized yet.
DEPLOYMENT_URL=
# Hosted token route only: exact authorized HTTPS origin, no path/query.
# Local localhost/127.0.0.1 practice does not need this.
APP_ORIGIN=
